   "source": [
    "import pandas as pd\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "bb0aa3fc",
   "metadata": {},
   "outputs": [],
   "source": [
    "data = {\n",
    "    \"Product\": [\"T-Shirt\", \"Jeans\", \"Shoes\", \"Jacket\", \"Bag\"],\n",
    "    \"Price\": [500, 1200, 2000, 1500, 800],\n",
    "    \"Qty\": [2, 1, 1, 2, 3]\n",
    "}\n",
    "\n",
    "df = pd.DataFrame(data)\n",
    "\n",
    "df[\"GST\"] = (df[\"Price\"] * df[\"Qty\"]) * 0.05\n",
    "\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "7339fe58",
   "metadata": {},
