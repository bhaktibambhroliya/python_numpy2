   "source": [
    "today = pd.Timestamp.today().normalize()\n",
    "\n",
    "# Generate dates including today\n",
    "date_range = pd.date_range(\n",
    "    start=today,\n",
    "    periods=7,\n",
    "    freq=\"D\"\n",
    ")"
   ]
  },
